# Copy this file to .env and fill in real values. Never commit the real .env file.

# Get this from Supabase: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Generate a strong random string, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=replace_this_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Resend.com API key for sending worker credential emails
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com

# Frontend login links used in credential emails - three separate apps on
# three separate origins. Update these to the real subdomains once deployed:
# ADMIN_APP_URL -> https://bssupport.care (root domain)
# WORKER_APP_URL -> https://app.bssupport.care
# CLIENT_APP_URL -> https://portal.bssupport.care
ADMIN_APP_URL=http://localhost:3000
WORKER_APP_URL=http://localhost:3001
CLIENT_APP_URL=http://localhost:3002

APP_NAME=Support Care Management API
ENVIRONMENT=development

# Comma-separated list handled as a list by pydantic-settings - update for your
# actual frontend URL(s) once deployed
CORS_ORIGINS=["http://localhost:3000"]
